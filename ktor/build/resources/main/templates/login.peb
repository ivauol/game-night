<!DOCTYPE html>
<html>
<head>
    <title> sign in page </title>
</head>

<style>
    *{
        margin:0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    body {
        background-color: rgb(40, 69, 199);
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .form-container {
        background: rgba(255,255,255,0.1);
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 0 15px rgbs(0,255, 255, 0.3);
        width: 320px;
        text-align: center;
    }
    
    h1{
        color:mediumturquoise;
        margin-bottom: 400px;
        display: flex;
    }

    p{
        color:#fff;
        text-align: center;
        font-family:Arial, Helvetica, sans-serif;
        font-size: x-large;
    }

    p{
        font-size: medium;

    }

    .input-box{
        margin: 20px 0;
    }

    .input-box input{
        width: 200px;
        padding: 12px 15px;
        background: none;
        border-color: aliceblue ;
        outline: none;
        color:beige;
        font-size: 20px;
    }
    
    .submit-bin{
        width: 100px;
        background-color: aqua;
        border-color:aquamarine;
        outline: none;
        font-family: Arial, Helvetica, sans-serif;
        font-size: large;
    }

    .sign-up{
        width: 100px;
        background-color: aqua;
        border-color:aquamarine;
        outline: none;
        font-family:Arial, Helvetica, sans-serif;
        font-size: large;
    }



</style>
<body> 
    
    <div class="form-container">
        <p>LOGIN</p>
        <div class= "input-box">
            <input type="text"placeholder="">
            <span>Username</span>
        </div>
        <div class= "input-box">
            <input type="text"placeholder="">
            <span>Password </span>
        </div>

        <button class="submit-bin">LOG-IN</button>
        <p></p>
        <p>Dont have an account?</p>
        <p></p>
        <button class="sign-up">SIGN-UP</button>
    </div>


</body>
</html>

