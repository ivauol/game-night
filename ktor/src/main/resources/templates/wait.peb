<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> game menu </title>
    <style>

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a, #1e293b, #312e81);
            color: white;
        }

        .glow {
            position: fixed;
            width: 500px;
            height: 500px;
            background: rgba(59,130,246,0.15);
            filter: blur(100px);
            border-radius: 50%;
            top: 10%;
            left: 5%;
            z-index: 0;
        }

        {# Icon-bar design implementation #}
        .icon-bar {
            width: 100%;
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
        }

        .icon-bar a {
            display: inline-block;
            padding: 18px 24px;
            color: white;
            font-size: 28px;
        }

        h1 { text-align: center; margin-bottom: 10px; font-size: 2.8rem; }

        .label {
            width: 30px;
            height: 30px;
            background: rgba(255,255,255,0.08);
            color: white;
            font-weight: bold;
            text-align: center;
        }

        .flex-container {
            min-height: calc(100vh - 160px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        button,
        .btn {
            margin-top:6px;
            border: none;
            text-decoration: none;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            padding: 18px 22px;
            border-radius: 999px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            box-shadow: 0 8px 25px rgba(59,130,246,0.35);
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        
        button:hover,
        .btn:hover{ 
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 30px rgba(139,92,246,0.45); 
        }

    </style>
</head>
<body>
    <div class="icon-bar">
        <a class="active" href="/gamecenter"><i class="fa fa-home"></i></a>
        <div style="float: right;">
            <a href="/stats" class="btn" style="font-size:16px">Profile</a>
            <form action="/logout" method="post" style="display:inline;">
                <button class="btn" type="submit">Logout</button>
            </form>
        </div>
    </div>

    <div class="glow"></div>

    <div class="flex-container">
        <h2>Waiting for an opponent...</h2>
        <script>
            const socket = new WebSocket(`ws://${window.location.host}/waitws`);
            
            //when an opponent has been found
            socket.onmessage = (event) => {
                const gameId = event.data

                const formData = new FormData();
                formData.append("gameId", gameId);

                //redirect to the new game immediately
                fetch("/join", {
                    method: "POST",
                    body: formData,
                }).then(() => {
                    window.location.replace(`/game?gameId=${gameId}`);
                });
            };
        </script>
    </div>

</body>
</html>