<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <style>

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a, #1e293b, #312e81);
            color: white;
            overflow-x: hidden;
        }

        .glow {
            position: fixed;
            width: 500px;
            height: 500px;
            background: rgba(59,130,246,0.15);
            filter: blur(100px);
            border-radius: 50%;
            top: 10%;
            left: 5%;
            z-index: 0;
        }

        .icon-bar {
            width: 100%;
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
        }

        .icon-bar a {
            display: inline-block;
            padding: 18px 24px;
            color: white;
            font-size: 28px;
        }

        h1 { text-align: center; margin-bottom: 10px; font-size: 2.8rem; }

        .label {
            width: 30px;
            height: 30px;
            background: rgba(255,255,255,0.08);
            color: white;
            font-weight: bold;
            text-align: center;
        }

        .flex-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: calc(100vh - 80px);
            padding: 20px;
        }

        .form-container {
            width: 100%;
            max-width: 500px;
            padding: 40px;
            border-radius: 24px;
            background: rgba(255,255,255,0.06);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 10px 40px rgba(0,0,0,0.4);
            text-align: center;
            z-index: 1;
        } 

        .form-container h1 {
            font-size: 2rem;
            margin-bottom: 5px;
        }

        .text {
            text-align: center;
            color: rgba(255, 255, 255, 0.877);
            font-size: 20px;
        }

        .btn {
            margin-top:6px;
            border: none;
            text-decoration: none;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            padding: 18px 22px;
            border-radius: 999px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            box-shadow: 0 8px 25px rgba(59,130,246,0.35);
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        
        .btn:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 30px rgba(139,92,246,0.45); 
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .stat-box {
            padding: 20px;
            border-radius: 16px;
            background: rgba(255,255,255,0.05);
            transition: 0.25s ease;
            margin-bottom: 5px;
        }

        .stat-box:hover {
            transform: translateY(-3px);
            background: rgba(139,92,246,0.15);
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: bold;
            color: #93c5fd;
        }

        .stat-label {
            font-size: 0.85rem;
            opacity: 0.7;
            margin-top: 5px;
        }

    </style>
</head>
<body>
    <div class="icon-bar">
        <a class="active" href="/gamecenter"><i class="fa fa-home"></i></a>
        <div style="float: right;">
                <a href="/stats" class="btn" style="font-size:16px">Profile</a>
                <form action="/logout" method="post" style="display:inline;">
                    <button class="btn" type="submit">Logout</button>
                </form>
        </div>
    </div>
    <div class="glow"></div>

    <div class="flex-container">
        <div class= "form-container">
            <h1>Username: {{username}}</h1>
            <h1>Email: {{email}} </h1><br>

            <div class="stat-box">
                <div class="stat-value">{{totalGames}}</div>
                <div class="stat-label">Total Games</div>
            </div>

            <div class="stat-box">
                <div class="stat-value">{{activeGames}}</div>
                <div class="stat-label">Active Games</div>
            </div>

            <div class="stat-box">
                <div class="stat-value">{{winRate}}</div>
                <div class="stat-label">Win Rate</div>
            </div>                        
        </div>
    </div> 

</body>
</html>