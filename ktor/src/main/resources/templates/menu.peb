<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Game menu </title>
    <style>
    
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a, #1e293b, #312e81);
            color: white;
            overflow-x: hidden;
        }
        .glow {
            position: fixed;
            width: 500px;
            height: 500px;
            background: rgba(59,130,246,0.15);
            filter: blur(100px);
            border-radius: 50%;
            top: 10%;
            left: 5%;
            z-index: 0;
        }

        .icon-bar {
            width: 100%;
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
        }
        .icon-bar a {
            display: inline-block;
            padding: 18px 24px;
            color: white;
            font-size: 28px;
        }

        h1 { text-align: center; margin-bottom: 10px; font-size: 2.8rem; }


        .label {
            width: 30px;
            height: 30px;
            background: rgba(255,255,255,0.08);
            color: white;
            font-weight: bold;
            text-align: center;
        }

        .btn {
            margin-top:6px;
            border: none;
            text-decoration: none;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            padding: 18px 22px;
            border-radius: 999px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            box-shadow: 0 8px 25px rgba(59,130,246,0.35);
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        
        .btn:hover{ 
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 30px rgba(139,92,246,0.45); 
        }

        .flex-container {
            display:grid;
            grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
            width: 100%;
            max-width:90%;
            align-items:center;
            margin-left:5%;
            margin-right:5%;
        }

        .form-container {
            width: 100%;
            min-height: 500px
            max-width: 500px;
            padding: 40px;
            border-radius: 24px;
            background: rgba(255,255,255,0.06);
            backdrop-filter: blur(14px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.35);
            border: 1px solid rgba(255,255,255,0.08);
            margin: 5px;
            cursor:pointer;

        } 

        a {
            text-decoration:none;
        }

        .form-container:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 12px 30px rgba(83, 32, 201, 0.45);
        }

        .form-container i{
            font-size: 50px;
            margin-bottom: 20px;
            color:#93c5fd;
        }

        .form-container words {
            text-decoration: none;
            color: #93c5fd;
            font-size: 2.5rem;
            font-weight: bold;

        }

        .form-container p{
            font-size: 0.9rem;
            opacity: 0.7;
            margin-top: 8px;
            color:white;
        }

    </style>
</head>
<body>    
    <div class="glow"></div>

    <div class="icon-bar">
        <a class="active" href="/gamecenter"><i class="fa fa-home"></i></a>
        <div style="float: right;">

            {% if login %}
                <a href="/login" class="btn" style="font-size:16px">Login</a>
                <a href="/register" class="btn" style="font-size:16px" >Register</a>
            {% else %}
                <a href="/stats" class="btn" style="font-size:16px">Profile</a>
                
                <form action="/logout" method="post" style="display:inline;">
                    <button class="btn" type="submit">Logout</button>
                </form>
            {% endif %}
        </div>
    </div>


    <body>
        <div class="flex-container">
            <a href="/search?status=active">
                <div class= "form-container">        
                    <i class="fa fa-play-circle"></i>
                    <words>Active Games</words>
                    <p>Join ongoing matches</p>
                </div>
            </a>

            <a href="/search?status=ended">
                <div class= "form-container">        
                    <i class="fa fa-history"></i>
                    <words>Ended Games</words>
                    <p>View completed games</p>     
                </div>
            </a>

            <a href="/wait">
                <div class= "form-container" >         
                    <i class="fa fa-plus-circle"></i>
                    <words> New Game</words>
                    <p>Create a new session</p>
                </div>
            </a>
        </div>
    </body>

</body>
</html>