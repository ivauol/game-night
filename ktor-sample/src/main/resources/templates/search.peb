<body>
    <ul>
        {% for game in games %}
            <li>
                Game ID: {{ game }}
                <form action="/join" method="post" style="display:inline;">
                    <input type="hidden" name="gameId" value="{{ game }}">
                    <button type="submit">Join Game</button>
                </form>
            </li>
        {% endfor %}
    </ul>

    <a href="/gamecenter">Back to Home</a>
</body>