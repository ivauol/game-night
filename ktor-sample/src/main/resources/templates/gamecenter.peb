<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> 
    <title>Game Center</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a, #1e293b, #312e81);
            color: white;
            overflow-x: hidden;
        }

        .glow {
            position: absolute;
            width: 420px;
            height: 420px;
            background: rgba(59,130,246,0.15);
            filter: blur(90px);
            border-radius: 50%;
            top: 8%;
            left: 8%;
            z-index: -1;
        }

        .icon-bar {
            width: 100%;
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }

        .icon-bar a {
            display: inline-block;
            padding: 18px 24px;
            color: white;
            font-size: 28px;
            transition: 0.3s ease;
        }

        .icon-bar a:hover {
            background: rgba(255,255,255,0.12);
        }

        .center {
            padding: 40px 20px 80px;
            max-width: 1200px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            font-size: 3rem;
            letter-spacing: 4px;
            margin-bottom: 30px;
            text-shadow: 0 4px 25px rgba(0,0,0,0.35);
        }

        .search-container {
            max-width: 500px;
            margin: 0 auto 40px;
        }

        .search-container form {
            display: flex;
            gap: 12px;
        }

        input[type=text] {
            flex: 1;
            padding: 14px 16px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.08);
            color: white;
            outline: none;
            font-size: 1rem;
        }

        input::placeholder {
            color: rgba(255,255,255,0.45);
        }

        .search-btn,
        .play-btn {
            border: none;
            text-decoration: none;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            padding: 14px 22px;
            border-radius: 999px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            box-shadow: 0 8px 25px rgba(59,130,246,0.35);
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .search-btn:hover,
        .play-btn:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 30px rgba(139,92,246,0.45);
        }

        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 28px;
        }

        .game-card {
            background: rgba(255,255,255,0.06);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(0,0,0,0.35);
            transition: transform 0.25s ease;
        }

        .game-card:hover {
            transform: translateY(-6px);
        }

        .game-image {
            width: 100%;
            height: 220px;
            object-fit: cover;
            display: block;
        }

        .game-info {
            padding: 22px;
        }

        .game-info h2 {
            margin-bottom: 10px;
            font-size: 1.5rem;
        }

        .game-info p {
            color: rgba(255,255,255,0.75);
            margin-bottom: 18px;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="glow"></div>

    <div class="icon-bar">
        <a href="/"><i class="fa fa-home"></i></a>
    </div>

    <section class="center">
        <h1>GAME CENTER</h1>

        <div class="search-container">
            <form action="/games/search" method="get">
                <input type="text" placeholder="Search games..." name="search">
                <button class="search-btn" type="submit"><i class="fa fa-search"></i></button>
            </form>
        </div>

        <div class="games-grid">
            <div class="game-card">
                <img class="game-image" src="/images/checkers-cover.png" alt="Checkers cover">
                <div class="game-info">
                    <h2>♟ Checkers</h2>
                    <p></p>
                    <a href="/game" class="play-btn">Play Now</a>
                </div>
            </div>

            <div class="game-card">
                <img class="game-image" src="${checkersImageUrl}" alt=" Game cover">
                <div class="game-info">
                    <h2>♟ Other Game</h2>
                    <p></p>
                    <a href="#" class="play-btn">Play Now</a>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
