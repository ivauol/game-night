  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{% block title %}Game Night{% endblock %}</title>
</head>
<body>
<h1>welcome page<h1>
<main>
    {% block content %}{% endblock %}
</main>
</body>
</html>