<h2>Waiting for an opponent...</h2>
<script>
    const socket = new WebSocket(`ws://${window.location.host}/waitws`);
    
    //when an opponent has been found
    socket.onmessage = (event) => {
        const gameId = event.data

        const formData = new FormData();
        formData.append("gameId", gameId);

        //redirect to the new game immediately
        fetch("/join", {
            method: "POST",
            body: formData,
        }).then(() => {
            window.location.replace(`/game?gameId=${gameId}`);
        });
    };
</script>