<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkers Game</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a, #1e293b, #312e81);
            color: white;
            overflow-x: hidden;
        }
        .glow {
            position: fixed;
            width: 500px;
            height: 500px;
            background: rgba(59,130,246,0.15);
            filter: blur(100px);
            border-radius: 50%;
            top: 10%;
            left: 5%;
            z-index: 0;
        }
        .icon-bar {
            width: 100%;
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
        }
        .icon-bar a {
            display: inline-block;
            padding: 18px 24px;
            color: white;
            font-size: 28px;
        }


        .game-panel {
            max-width: 900px;
            margin: 0 auto;
            padding: 30px;
            border-radius: 24px;
            background: rgba(255,255,255,0.06);
            backdrop-filter: blur(14px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.35);
            border: 1px solid rgba(255,255,255,0.08);
            position: relative;
            z-index: 2;
        }

        h1 {
            text-align: center;
            margin-bottom: 10px;
            font-size: 2.8rem;
        }

        #status {
            text-align: center;
            margin: 12px 0 24px;
            color: #cbd5e1;
            font-weight: bold;
        }

        .board-container {
            display: flex;
            justify-content: center;
            margin: 20px 0;
        }

        .checkers-board {
            border-collapse: collapse;
            box-shadow: 0 8px 24px rgba(0,0,0,0.35);
            overflow: hidden;
            border-radius: 16px;
        }

        .square {
            width: 60px;
            height: 60px;
            text-align: center;
            vertical-align: middle;
        }

        .light { background-color: #f0d9b5; }
        .dark { background-color: #312600f7; }

        .label {
            width: 30px;
            height: 30px;
            background: rgba(255,255,255,0.08);
            color: white;
            font-weight: bold;
            text-align: center;
        }

        .piece {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            margin: auto;
            margin-top: 8px;
            box-shadow: inset 0 2px 4px rgba(255,255,255,0.4),
                        inset 0 -2px 4px rgba(0,0,0,0.3),
                        0 2px 4px rgba(0,0,0,0.3);
        }

        .white-piece { background: radial-gradient(circle at 30% 30%, #ffffff, #cbd5e1); }
        .black-piece { background: radial-gradient(circle at 30% 30%, #64748b, #0f172a); }

        .king {
            position: relative;
        }

        .king::after {
            content: "♔";
            position: absolute;
            font-size: 39px;
            top: -6px;
            left: 50%;
            transform: translateX(-50%);
            color: gold;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }

        #moveForm {
            max-width: 500px;
            margin: 30px auto 0;
            display: flex;
            gap: 12px;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            position: relative;
            z-index: 2;
        }

        #move {
            flex: 1;
            min-width: 220px;
            padding: 14px 16px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.08);
            color: white;
            font-size: 1rem;
            outline: none;
        }

        #move::placeholder { color: rgba(255,255,255,0.45); }

        .popup,
        button {
            margin-top:6px;
            border: none;
            text-decoration: none;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            padding: 18px 22px;
            border-radius: 999px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            box-shadow: 0 8px 25px rgba(59,130,246,0.35);
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        
        .popup:hover,
        button:hover { 
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 30px rgba(139,92,246,0.45); 
        }

        .button {
            display:center;
            margin-top:6px;
            border: none;
            text-decoration: none;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            padding: 18px 22px;
            border-radius: 999px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            box-shadow: 0 8px 25px rgba(59,130,246,0.35);
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        
        .button:hover { 
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 30px rgba(139,92,246,0.45); 
        }


        .username_btn {
            display:center;
            margin-top:2px;
            text-decoration: none;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            padding: 18px 22px;
            border-radius: 999px;
            background: linear-gradient(135deg, #4136e0);
            box-shadow: 0 8px 25px rgba(59,130,246,0.35);
            cursor: pointer;
            font-size:16px;
            margin-right: 5px;
        }

        .flex-container {
            min-height: calc(100vh - 160px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px;
        }

        .form-container {
            width: 100%;
            max-width: 1000px;
            padding: 30px;
            border-radius: 24px;
            background: rgba(255,255,255,0.06);
            backdrop-filter: blur(14px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.35);
            border: 1px solid rgba(255,255,255,0.08);
            margin: 5px;

        } 

        .container {
            width: 25%;
            max-width: 1000px;
            padding: 40px;
            border-radius: 24px;
            background: rgba(255,255,255,0.06);
            backdrop-filter: blur(14px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.35);
            border: 1px solid rgba(255,255,255,0.08);
            margin: 5px;

        }

        .popup {
            position: relative;
            text-align: center;
            display: inline-block;
            cursor: pointer;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }   

        /* The actual popup */
        .popup .popuptext {
            visibility: hidden;
            width: 400px;
            background-color: #93a1e1;
            color: #fff;
            text-align: center;
            border-radius: 6px;
            padding: 8px 0;
            position: absolute;
            z-index: 1;
            bottom: 125%;
            left: 50%;
            margin-left: -80%;
        }


        /* Toggle this class - hide and show the popup */
        .popup .show {
            visibility: visible;
            -webkit-animation: fadeIn 1s;
            animation: fadeIn 1s;
        } 

    </style>
</head>
<body>
    <div class="glow"></div>

    <div class="icon-bar">
        <a class="active" href="/gamecenter"><i class="fa fa-home"></i></a>
        

        <div style="float: right;">
        
            <b class="username_btn"> {{username}} </b>

            {% if login %}
                <a href="/login" class="button" style="font-size:16px">Login</a>
                <a href="/register" class="button" style="font-size:16px" >Register</a>
            {% else %}
                <a href="/stats" class="button" style="font-size:16px">Profile</a>
                
                <form action="/logout" method="post" style="display:inline;">
                    <button class="button" type="submit" margin-left="2px">Logout</button>
                </form>
            {% endif %}
        </div>    
    </div>



    {#display black's id#}

    <div class="flex-container">
        <div class="form-container">
            <div class="game-panel">
                <h1>♟ Checkers Game</h1>

                <div class="board-container">
                    <table class="checkers-board">
                        <tr>
                            <td></td>
                            {% for col in ['A','B','C','D','E','F','G','H'] %}
                                <td class="label">{{ col }}</td>
                            {% endfor %}
                        </tr>
                        {% for row in [1,2,3,4,5,6,7,8] %}
                        <tr>
                            <td class="label">{{ row }}</td>
                            {% for col in [1,2,3,4,5,6,7,8] %}
                                <td class="square {% if (row + col) is even %}light{% else %}dark{% endif %}"></td>
                            {% endfor %}
                        </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>

        </div>

        <div class="container">
        
            <div style="text-align:center; margin-top:20px;" id="blackPlayer">
                Black: <span id="blackId">{{ black }}</span>
            </div>

            <p style="text-align:center;">Your ID: {{ playerId }}</p>

            <div style="text-align:center; margin-top:20px;" id="whitePlayer">
                Opponents ID:<span id="whiteId"> {{ white }}</span> <br>
            </div>

            <p id="errorBox" style="text-align:center"></p>
            <p id="movePreview" style="text-align:center; margin-top:10px;"></p>

            <div style="text-align:center; margin-top:10px;">
                <button type="button" id="submitMoveBtn" style="font-size:18px">Submit Move</button>
                <button type="button" id="clearMoveBtn" style="font-size:18px">Clear</button>
            </div>
            
            <div class="form-container ">
                <p style= "font-size: 20px; text-align: center">
                    1. Select the <em> checker </em> you want to move <br><br>
                    2. Select the <em> square </em> you want to move to <br><br>
                    3. Submit the move!
                </p>

            </div>
            <br>
            <div style="width:100%; font-size:18px" 
                class="popup" onclick="myFunction()" style="text-align: center;" > HOW TO PLAY
                <span class="popuptext" id="myPopup">
                    <p>Checkers is a two-player game where the objective is to capture all of your opponent's pieces
                         or block them so they cannot move. 
                        <br> 1. Each player starts with 12 pieces placed on the dark squares of 
                        the board.<br> 2. Players take turns moving their pieces diagonally 
                        forward to an adjacent empty square. <br> 3. If an opponent's piece is 
                        adjacent and the square beyond it is empty, you can jump over it 
                        to capture it. <br> 4. If a piece reaches the opposite end of the board, it becomes a king and 
                        can move both forward and backward. 
                        <br> 5. The first player to capture all opponent pieces
                         or block them wins the game!</p>
                </span> 
            </div>

            <script>
                // When the user clicks on div, open the popup
                function myFunction() {
                    var popup = document.getElementById("myPopup");
                    popup.classList.toggle("show");
                }
            </script>

        </div>
    </div>

    
    <script>
        //define global variables
        window.squares = [];
        window.player = "";
        if ({{black}} == {{playerId}}){
            window.player = "black";
        }
        else if ({{white}} == {{playerId}}){
            window.player = "white";
        }
        window.current = "{{current}}";
        window.winner = "{{winner}}";
        window.gameId = "{{gameId}}";
    </script>

    <script src = "/js/game.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const boardString = "{{ boardString }}";

            //prepare all visual elements on load
            const board = parseBoardString(boardString);
            updateBoardHTML(board);
            currentPlayer("{{current}}");
            winCheck("{{winner}}");
            buttonVisible();

            //set up a button in each cell on load
            const table = document.querySelector(".checkers-board");
            for (let i = 0; i <= 7; i++) {
                for (let j = 0; j <= 7; j++) {
                    const cell = table.rows[i+1].cells[j+1];
                    cell.addEventListener("click", () => {
                        handleSquareClick(i, j, cell);
                    });
                }
            }

            //open a new connection
            const socket = new WebSocket(`ws://${window.location.host}/gamews?gameId={{gameId}}`);
            socket.onopen = () => console.log("WebSocket connected");
            //update the page if any changes have occurred
            socket.onmessage = (event) => {
                console.log("Received:", event.data);
                const parts = event.data.split(",")
                const newBoard = parseBoardString(parts[0]);
                updateBoardHTML(newBoard);
                currentPlayer(parts[2]);
                window.current = parts[2];
                
                window.winner = winCheck(parts[1]);
                buttonVisible();
            };

            document.getElementById("submitMoveBtn").addEventListener("click", submitMove);
            document.getElementById("clearMoveBtn").addEventListener("click", clearSelection);
        });
    </script>
</body>