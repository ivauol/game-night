{#Display the board#}
<div style="display:flex; justify-content:center; margin-top:20px;">
    <table border="1" cellspacing="0" cellpadding="4">
        <tr>
            <td></td>
            {#column labels#}
            {% for col in ['A','B','C','D','E','F','G','H'] %}
            <td style="width:20px; height:20px; text-align:center;"><b>{{ col }}</b></td>
            {% endfor %}
        </tr>
        {% for row in board %}
        <tr>
            {#row labels#}
            <td style="text-align:center;"><b>{{ loop.index + 1 }}</b></td> {# row label #}
            {% for cell in row %}
            {#draw the right piece label#}
            <td style="width:20px; height:20px; text-align:center;">
                {{ cell }}
            </td>
            {% endfor %}
        </tr>
        {% endfor %}
    </table>
</div>
{#move making option#}
<form action="/move" method="post" style="justify-content:center; margin-top:180px;">
    <input type="hidden" name="game_id" value="{{ game_id }}">
    <input type="hidden" name="player_id" value="{{ player_id }}">
    <label for="move">Enter move:</label>
    <input type="text" name="move" id="move">
    <button type="submit">Submit Move</button>
</form>